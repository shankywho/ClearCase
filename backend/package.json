{
  "name": "clearcase-backend",
  "version": "1.0.0",
  "description": "Offline-First, Voice-Native AI Dispute Resolution Mesh for Bharat - Backend & Data Access Layer",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "tsx scripts/unit-test.ts",
    "test:ai": "tsx scripts/test-ai-orchestration.ts",
    "test:phase3": "tsx scripts/test-phase3.ts",
    "test:phase4": "tsx scripts/test-phase4.ts",
    "test:e2e": "tsx scripts/test-e2e-connected.ts",
    "test:python": "./venv/bin/python test_ai_pipeline.py && ./venv/bin/python test_comprehensive_suite.py",
    "test:all": "npm run build && npm test && npm run test:ai && npm run test:phase3 && npm run test:phase4 && npm run test:e2e",
    "db:init": "tsx scripts/init-local-db.ts",
    "db:test": "tsx scripts/test-repositories.ts",
    "aws:teardown": "bash scripts/teardown-aws.sh"
  },
  "keywords": [
    "aws",
    "dynamodb",
    "sam",
    "ai",
    "dispute-resolution",
    "bharat"
  ],
  "author": "ClearCase Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1135.0",
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/client-polly": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.13.9",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
