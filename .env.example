# ==============================================================================
# ClearCase: Environment & Configuration Template (.env.example)
# Copy this file to .env and fill in your credentials.
# Note: ClearCase functions seamlessly in offline demo mode even with empty keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Cloud Infrastructure (Bedrock, Polly, DynamoDB)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN= (Required if using temporary AWS Academy / Learner Lab / SSO credentials)

# Amazon Bedrock Foundation Models
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1

# ------------------------------------------------------------------------------
# 2. Open-Source LLM Fallback (Groq Cloud)
# ------------------------------------------------------------------------------
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 3. Python AI Microservice Flags
# ------------------------------------------------------------------------------
# When true, uses high-fidelity calibrated offline RAG without calling AWS Bedrock APIs
MOCK_AI=true
# embedding: 'local' (SentenceTransformer all-MiniLM-L6-v2) or 'bedrock' (Titan)
EMBEDDING_PROVIDER=local
# vector store: 'chroma' or 'local' (NumPy/JSON index)
VECTOR_STORE=chroma
PORT=8000

# ------------------------------------------------------------------------------
# 4. Node.js Backend Integration Flags
# ------------------------------------------------------------------------------
USE_PYTHON_AI=true
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. DynamoDB (Single-Table Design)
# ------------------------------------------------------------------------------
TABLE_NAME=ClearCaseTable-local
DYNAMODB_ENDPOINT=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. Polygon Amoy Blockchain Anchoring
# ------------------------------------------------------------------------------
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/
CLEARCASE_REGISTRY_ADDRESS=0x435A9D490EbF92C32D19D20888913B0957917C5B
PRIVATE_KEY=mock-key
MOCK_BLOCKCHAIN=true

# ------------------------------------------------------------------------------
# 7. SMS / IVR OTP Stubs (Optional Twilio / Exotel)
# ------------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
